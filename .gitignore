.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/local.properties

# Widget Preview related
.widget_preview/

# Python training
__pycache__/
*.py[cod]
.venv/

# Large processed research dumps (keep splits, model assets, READMEs)
/data/raw/*
!/data/raw/README.md
/data/processed/*
!/data/processed/README.md
/data/features/*.csv

# Downloaded research archives — obtain from sources in DATASETS.md
/Non-EEG Dataset for Assessment of Neurological Status/
/wearable-device-dataset-from-induced-stress-and-structured-exercise-sessions-1.0.1/
/LOGO/
/artifacts/

# Credential material
*.pem
*.p12
*.key

# OS / local dumps
Thumbs.db
Desktop.ini
.playwright-mcp/

# Secrets — never commit service-role or personal keys
.env
.env.*
!.env.example
